# Telegram bot tokeni — @BotFather dan oling
BOT_TOKEN=8674519587:AAEusMZP4P7px_-Zm3lqNSV7SP-sNWLQL-w

# OpenRouter API kaliti — https://openrouter.ai dan oling
# AI dars va test generatsiya uchun kerak. Bo'sh qoldirsangiz AI ishlamaydi.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini API kaliti — https://aistudio.google.com/apikey dan oling
# Esse tekshirish va AI dars generatsiya uchun (OpenRouter o'rniga).
# GEMINI_API_KEY bo'lsa — u ishlatiladi, bo'lmasa OpenRouter ishlatiladi.
GEMINI_API_KEY=your_gemini_api_key_here

# Mini App web server sozlamalari
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# Mini App public URL (HTTPS bo'lishi SHART)
# Telegram telefon orqali faqat HTTPS qabul qiladi.
# Lokal development uchun ngrok/cloudflared ishlatng:
#   ngrok http 8080
#   yoki
#   cloudflared tunnel --url http://localhost:8080
# Hosil bo'lgan https://... URL ni shu yerga qo'ying.
WEBAPP_URL=https://your-tunnel.ngrok-free.app

# Mini App tugmasi matni (Telegram chap pastdagi ko'k tugma)
WEBAPP_BUTTON_TEXT=🚀 Mini App ochish